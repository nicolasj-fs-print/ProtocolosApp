# ============================================================
# CONEXIÓN SQL SERVER
# ============================================================
# Driver ODBC. La app lo instala automáticamente desde tools/msodbcsql18.msi
# si no está presente.
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=HOST\INSTANCE_O_HOST,PUERTO
SQL_DATABASE=NOMBRE_DB

# Autenticación: si TRUSTED_CONNECTION=true se usa Windows Auth
# (SQL_USER/SQL_PASSWORD se ignoran).
SQL_TRUSTED_CONNECTION=false
SQL_USER=tu_usuario_sql
SQL_PASSWORD=tu_password_sql

# TrustServerCertificate=yes evita el error "self-signed certificate" del driver 18.
SQL_TRUST_SERVER_CERT=yes
SQL_ENCRYPT=yes

# Base de datos secundaria para lookup de trazabilidad (mismo server/credenciales).
SQL_DATABASE_TRAZABILIDAD=NOMBRE_DB_TRAZABILIDAD

# ============================================================
# MICROSOFT GRAPH / SHAREPOINT
# ============================================================
# STORAGE_BACKEND: sharepoint (default) | local (legacy fallback).
STORAGE_BACKEND=sharepoint

# GUIDs de la App Registration en Azure AD (pedir a TI / admin del tenant).
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Hostname y nombre del sitio SharePoint principal (donde viven los datos).
SHAREPOINT_HOSTNAME=tutenant.sharepoint.com
SHAREPOINT_SITE=NombreDelSitio

# Sitio aparte para telemetría/control de la app (Logs, Ejecuciones, Usuarios).
# Si SP_APP_SITE está vacío, la telemetría se guarda en el sitio principal.
SP_APP_HOSTNAME=tutenant.sharepoint.com
SP_APP_SITE=

# Paths relativos al drive default del sitio (Documentos compartidos).
SP_CLIENTS_FILE=STOCK PAPEL/Stock Mendoza.xlsm
SP_INGRESOS_FILE=Protocolos Calidad/Protocolos x Ingreso OK.xlsx
SP_PROTOCOLS_FOLDER=Protocolos Calidad/Protocolos
SP_OUTPUT_FOLDER=Protocolos Calidad/Reportes Finales

# Telemetría / control de la app — agrupados bajo Protocolos Calidad/ProtocolosApp/.
SP_LOGS_FOLDER=Protocolos Calidad/ProtocolosApp/Logs
SP_EJECUCIONES_FOLDER=Protocolos Calidad/ProtocolosApp/Ejecuciones
SP_USUARIOS_FILE=Protocolos Calidad/ProtocolosApp/Usuarios/usuarios.xlsx

# ============================================================
# RUTAS LOCALES (solo si STORAGE_BACKEND=local — fallback legacy)
# ============================================================
PROTOCOLS_FOLDER=
DEFAULT_OUTPUT_FOLDER=
CLIENTS_XLSX=
CLIENTS_SHEET=Clientes
INGRESOS_XLSX=
INGRESOS_SHEET=

# Visor PDF opcional (relativo al proyecto / bundle).
SUMATRA_PATH=tools\SumatraPDF.exe

# ============================================================
# COMPORTAMIENTO
# ============================================================
LOG_LEVEL=INFO

# Modo MOCK: usa datos hardcoded en data_service para probar el pipeline PDF sin DB.
MOCK_DATA=false
