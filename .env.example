# ============================================================
# CONEXIÓN SQL SERVER
# ============================================================
# Driver ODBC. Instalar tools/msodbcsql18.msi si no está presente.
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=SERVER\INSTANCE
SQL_DATABASE=FSPRINT

# Autenticación: si TRUSTED_CONNECTION=true se usa Windows Auth (SQL_USER/SQL_PASSWORD se ignoran).
SQL_TRUSTED_CONNECTION=false
SQL_USER=fsexterno
SQL_PASSWORD=adnuecf623%@WQ

# TrustServerCertificate=yes evita el error "self-signed certificate" del driver 18.
SQL_TRUST_SERVER_CERT=yes
SQL_ENCRYPT=yes

# Base de datos secundaria para lookup de trazabilidad (mismo server/credenciales).
SQL_DATABASE_TRAZABILIDAD=FSBI

# ============================================================
# MICROSOFT GRAPH / SHAREPOINT
# ============================================================
# STORAGE_BACKEND: sharepoint (default) | local (legacy fallback)
STORAGE_BACKEND=sharepoint

MS_TENANT_ID=a745456b-61e6-4c44-8d38-b98313c87312
MS_CLIENT_ID=fc2a3128-34bd-46a5-9568-2510269e872e

SHAREPOINT_HOSTNAME=fsprintprojects.sharepoint.com
SHAREPOINT_SITE=VentasPowerBI

# Sitio aparte para telemetría/control de la app (Logs, Ejecuciones, Usuarios).
# Si SP_APP_SITE está vacío, la telemetría se guarda en el sitio principal.
SP_APP_HOSTNAME=fsprintprojects.sharepoint.com
SP_APP_SITE=

SP_CLIENTS_FILE=STOCK PAPEL/Stock Mendoza.xlsm
SP_INGRESOS_FILE=Protocolos Calidad/Protocolos x Ingreso OK.xlsx
SP_PROTOCOLS_FOLDER=Protocolos Calidad/Protocolos
SP_OUTPUT_FOLDER=Protocolos Calidad/Reportes Finales

# Telemetría / control de la app — agrupados bajo Protocolos Calidad/ProtocolosApp/.
SP_LOGS_FOLDER=Protocolos Calidad/ProtocolosApp/Logs
SP_EJECUCIONES_FOLDER=Protocolos Calidad/ProtocolosApp/Ejecuciones
SP_USUARIOS_FILE=Protocolos Calidad/ProtocolosApp/Usuarios/usuarios.xlsx

# ============================================================
# RUTAS (carpetas SharePoint sincronizadas localmente)
# ============================================================
PROTOCOLS_FOLDER=C:\Users\Nicolas.Jerez\FS PRINT & PROJECTS SA\Ventas PowerBI - Documentos\Protocolos Calidad\Protocolos
DEFAULT_OUTPUT_FOLDER=C:\Users\Nicolas.Jerez\FS PRINT & PROJECTS SA\Ventas PowerBI - Documentos\Protocolos Calidad\Reportes Finales
CLIENTS_XLSX=C:\Users\Nicolas.Jerez\FS PRINT & PROJECTS SA\Ventas PowerBI - Documentos\STOCK PAPEL\Stock Mendoza.xlsm
CLIENTS_SHEET=Clientes

# Excel de cruce protocolo/ingreso. Cols F=LF, G=Producto, H=Protocolo.
INGRESOS_XLSX=C:\Users\Nicolas.Jerez\FS PRINT & PROJECTS SA\Ventas PowerBI - Documentos\Protocolos Calidad\Protocolos x Ingreso OK.xlsx
INGRESOS_SHEET=

# Visor PDF opcional (relativo al proyecto / bundle).
SUMATRA_PATH=tools\SumatraPDF.exe

# ============================================================
# COMPORTAMIENTO
# ============================================================
LOG_LEVEL=INFO

# Modo MOCK: usa datos hardcoded en data_service para probar el pipeline PDF sin DB.
MOCK_DATA=false
